rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Balances: a signed-in user reads their own wallet. Only the postback function writes it.
    match /wallets/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Reward history: a user reads their own transactions (query with where('uid', '==', uid)).
    match /moonetix_tx/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
